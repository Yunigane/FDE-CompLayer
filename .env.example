# ==============================================================================
# AI Compliance Layer & Reference App Configuration Template
# Copy this file to .env for local development and compliance testing:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Reference App Authentication
# ------------------------------------------------------------------------------
# Bearer token used by the reference SQL Explainer service.
# If omitted, defaults to "mock-compliance-test-token" to allow zero-config startup.
APP_BEARER_TOKEN=mock-compliance-test-token

# ------------------------------------------------------------------------------
# 2. Reference App LLM Execution Mode
# ------------------------------------------------------------------------------
# When true (default), the reference app runs a deterministic, offline simulation
# with zero external API calls, zero latency, and zero cloud spend.
# Set to false to test live completions against an upstream LLM provider.
USE_MOCK_LLM=true

# ------------------------------------------------------------------------------
# 3. Model Provider Credentials & LLM-as-a-Judge (Optional)
# ------------------------------------------------------------------------------
# Used for:
#   a) Live SQL explanations in app/ when USE_MOCK_LLM=false.
#   b) Semantic advisory LLM-as-a-judge evaluations when running:
#      python checker/checker.py --judge
#
# The compliance checker automatically detects the active provider and model:
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # Optional: Compatible with Groq, Ollama, vLLM, DeepSeek, Azure
# OPENAI_JUDGE_MODEL=gpt-4o-mini              # Optional: Model override for OpenAI judge

# Alternative Judge Providers (Optional):
# ANTHROPIC_API_KEY=                         # For Claude judge (default: claude-3-5-haiku-20241022)
# GEMINI_API_KEY=                            # For Gemini judge (default: gemini-1.5-flash)
