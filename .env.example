# Environment Configuration Template
# Copy to .env for local overrides

# Bearer token for authenticating against the service (REQUIRED: must be set to start the app)
APP_BEARER_TOKEN=mock-compliance-test-token

# Optional: Live OpenAI API Key (leave empty to use deterministic offline mock mode)
OPENAI_API_KEY=

# Set to true to force deterministic mock responses even if OPENAI_API_KEY is present
USE_MOCK_LLM=true
